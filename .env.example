# Opções locais sem credenciais. O Node não carrega este arquivo automaticamente.
# Após copiar para .env e gerar o build, use:
# node --env-file=.env server/index.js
PORT=3000
HOST=127.0.0.1

# Se alterar o diretório, use o mesmo DATA_DIR em npm run admin:create.
# DATA_DIR=/caminho/para/dados-persistentes

# Para hospedagem com HTTPS e proxy reverso, ajuste estas opções.
COOKIE_SECURE=false
# APP_ORIGIN=https://ouvidoria.faculdade.example
